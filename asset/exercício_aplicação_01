#include <stdio.h>
#define PI 3.14159

int main() {
    
    
    float raio, perimetro;
    
    printf("Digite a medida do raio (em cm): ");
    scanf("%f", &raio);
    perimetro = 2*PI*raio;
    printf("O perimetro total da circunferência é (em cm): %.2f", perimetro);
   
    
    return 0;
    
}    
