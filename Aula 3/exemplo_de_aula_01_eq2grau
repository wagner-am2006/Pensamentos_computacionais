#include <stdio.h>
#include <math.h>

int main()
{
    float a, b, c;
    float delta, x1, x2;
    
    printf("Digite o valor de A: ");
    scanf("%f", &a);
    printf("Digite o valor de B: ");
    scanf("%f", &b);
    printf("Digite o valor de C: ");
    scanf("%f", &c);
    
    delta = ((b*b)-4)*a*c;
    x1 = (-b + (delta / delta))/ (2 * a);
    x2 = (-b - (delta / delta))/ (2 * a);
    
    printf("\n O valor de x1 é %.1f e o valor de x2 é %.1f", x1, x2 );
    

    return 0;
}
